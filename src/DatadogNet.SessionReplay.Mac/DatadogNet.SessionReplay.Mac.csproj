<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DatadogFramework>DatadogSessionReplay</DatadogFramework>
    <DatadogPackageName>SessionReplay</DatadogPackageName>
    <!--
      The second sentence is the honest part, aligned with the README and the sample: upstream's
      recorder is iOS/iPadOS-only, so this package exists for link-compatibility on Catalyst, and
      the description must not sell recording that never happens there. Descriptions are owned by
      this repository (not synced from DatadogNet.iOS), so the caveat lives here safely.
    -->
    <Description>.NET for Mac Catalyst / .NET MAUI bindings for the native Datadog iOS SDK's DatadogSessionReplay framework: records and replays user sessions, with privacy levels that mask text and user input. Session Replay is iOS/iPadOS-only upstream and records nothing on Mac Catalyst - this package ships so shared code that references it compiles and links unchanged. Built against dd-sdk-ios $(DatadogNativeVersion). Requires RUM to be enabled.</Description>
    <PackageTags>datadog-session-replay;session-replay</PackageTags>
  </PropertyGroup>

  <Import Project="../Datadog.Binding.props" />

  <!--
    ProjectReference, not PackageReference: `dotnet pack` turns each one into a NuGet dependency on
    the referenced package at the same version, so the published graph is identical either way -
    but a PackageReference at $(Version) cannot restore until that version has been packed, which
    makes a clean clone unbuildable and forces every local build through the packing script in
    dependency order.
  -->
  <ItemGroup>
    <ProjectReference Include="../DatadogNet.Core.Mac/DatadogNet.Core.Mac.csproj" />
    <ProjectReference Include="../DatadogNet.Internal.Mac/DatadogNet.Internal.Mac.csproj" />
  </ItemGroup>

</Project>
